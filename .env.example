# ===== 环境变量（复制为 .env 并填写）=====
# 复制命令：cp .env.example .env

# --- 阿里云百炼（DashScope）---
# Key 按地域绑定：北京/新加坡 不可混用，跨区调用会返回 401 invalid_api_key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型（以百炼控制台实际可选项为准）
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
RERANK_MODEL=qwen3-rerank
CHAT_MODEL=qwen-plus
REWRITE_MODEL=qwen-turbo

# --- MySQL ---
# 宿主 3306 被本机 MySQL80 服务占用，容器映射到 13306（见 docker/docker-compose.yml）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=rag
MYSQL_PASSWORD=rag_pass
MYSQL_DB=rag

# --- Milvus ---
# 宿主 19530 属 /d/rag项目 老项目，容器映射到 29530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=29530
MILVUS_COLLECTION=chunks

# --- 应用 ---
ADMIN_TOKEN=change-me-admin-token
LOG_LEVEL=INFO

# --- 检索默认配置（可被 /api/chat 请求覆盖）---
RETRIEVAL_MODE=hybrid          # dense | sparse | hybrid
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
USE_RERANK=true
RERANK_TOP_N=5
USE_QUERY_REWRITE=true
MIN_SCORE_THRESHOLD=0.0

# --- 可选：LangSmith 追踪（默认关闭）---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-customer-service
